# Private container health endpoint; never published.
http://:8081 {
	respond /health "ok" 200
}

(proxy_headers) {
	# Caddy preserves Host and replaces untrusted X-Forwarded-For by default.
	header_up -Forwarded
	header_up X-Forwarded-Host {env.PUBLIC_AUTHORITY}
	header_up X-Forwarded-Proto {env.PUBLIC_SCHEME}
	flush_interval -1
}

{$CADDY_SITE_ADDRESS} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; form-action 'self'; frame-src 'self' blob:; script-src 'self' blob: 'wasm-unsafe-eval' 'sha256-fCaVxzn99NXIV2Sj1rVbVZxfp8DmlTnAEsbUyIxGxjg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: blob:; connect-src 'self' blob: https: {env.PRESENCE_ORIGIN}; worker-src 'self' blob:"
	}
	@https expression `{env.PUBLIC_SCHEME} == "https"`
	header @https Strict-Transport-Security "max-age=31536000"

	@regions path /regions.json /.well-known/lunaris-regions
	handle @regions {
		header Content-Type application/json
		header Cache-Control no-store
		header Access-Control-Allow-Origin *
		header Cross-Origin-Resource-Policy cross-origin
		respond `{"schemaVersion":1,"regions":[{"regionId":"selfhost","displayName":"Self-hosted","manifestUrl":"{env.PUBLIC_URL}/v1/manifest","status":"available"}]}`
	}
	handle /.well-known/lunaris-servers {
		header Content-Type application/json
		header Cache-Control no-store
		header Access-Control-Allow-Origin *
		header Cross-Origin-Resource-Policy cross-origin
		respond `{"schemaVersion":1,"servers":[{"serverId":"selfhost","displayName":"Self-hosted","manifestUrl":"{env.PUBLIC_URL}/v1/manifest","status":"available"}]}`
	}
	handle /.well-known/security.txt {
		file_server
	}
	# Better Auth verification tokens must reach API, even on GET requests.
	@verification {
		path /auth/verify-email /auth/verify-email/
		query token=*
	}
	handle @verification {
		reverse_proxy api:3000 {
			import proxy_headers
		}
	}
	@auth_pages {
		method GET HEAD
		path_regexp auth_pages ^/auth(?:/(email|continue|register|forgot-password|reset-password|two-factor|verify-email|onboarding|accept-invitation|agent-consent))?/?$
	}
	handle @auth_pages {
		header Cache-Control "no-cache, no-store, must-revalidate"
		rewrite * /index.html
		file_server
	}
	handle_path /sync/* {
		reverse_proxy powersync:80 {
			import proxy_headers
		}
	}
	# S3 signatures cover both the unmodified URI and original Host.
	handle /lunaris/* {
		reverse_proxy garage:3900 {
			import proxy_headers
		}
	}
	@api path /v1 /v1/* /auth /auth/* /api /api/* /oauth2 /oauth2/* /.well-known/*
	handle @api {
		request_body {
			max_size 256MB
		}
		reverse_proxy api:3000 {
			import proxy_headers
		}
	}
	handle {
		header Cache-Control "no-cache"
		@immutable path_regexp immutable (?:^|/)[^/]+-[A-Za-z0-9_-]{8,}\.[^/]+$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@update path / /index.html /sw.js /manifest.webmanifest
		header @update Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} {path}/ /index.html
		file_server
	}
}
