{
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"root": false,
	"extends": ["../../biome.jsonc"],
	"files": {
		"includes": [
			"**",
			"!.next",
			"!build",
			"!node_modules",
			"!out",
			"!next-env.d.ts",
			// Generated SVGs must remain byte-identical to brand source assets.
			"!!public/favicon-dark.svg",
			"!!public/favicon-light.svg",
			"!!public/img/lunaris-mark-dark.svg",
			"!!public/img/lunaris-mark-light.svg"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"includes": ["**"]
	},
	"assist": {
		"actions": {
			"source": {
				"useSortedAttributes": "off"
			}
		}
	},
	"linter": {
		"includes": ["**"]
	},
	"overrides": [
		{
			"includes": ["src/i18n/dictionaries/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		}
	]
}
