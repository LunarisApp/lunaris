    "@repo/agent-contracts",
    "@repo/agent-work",
    "@repo/app-shell",
    "@repo/auth",
    "@repo/data",
    "@repo/ee-audit",
    "@repo/ee-composition",
    "@repo/ee-teams",
    "@repo/features",
    "@repo/platform",
    "@repo/plugin-runtime",
    "@repo/typescript-config",
    "@repo/utils",
    "@repo/workspaces",
    "api",
    "cli",
    "desktop",
    "docs",
    "e2e",
    "landing",
    "self-hosted",
    "web"
  ],
  "privatePackages": {
