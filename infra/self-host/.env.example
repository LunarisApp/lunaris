# install.sh creates .env with unique secrets. Keep it with your backups.
PUBLIC_URL=https://notes.example.com
COMPOSE_PROJECT_NAME=lunaris-self-host
TLS_MODE=auto
# TLS_MODE=external uses an existing HTTPS proxy; defaults to 127.0.0.1:8080.
SIGNUPS_ALLOWED=true
EMAIL_VERIFICATION_DISABLED=true
# Optional mail delivery (password reset and invitations require email):
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SELF_HOSTED_PLAN=enterprise
# Generated once by install.sh:
DATABASE_PASSWORD=
POWERSYNC_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
LOCAL_DB_ENCRYPTION_MASTER_KEY=
AUDIT_LOG_HMAC_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
