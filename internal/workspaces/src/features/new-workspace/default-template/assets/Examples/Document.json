  "$root": "<blockgroup><blockcontainer id=\"brief-title\"><heading backgroundColor=\"default\" isToggleable=\"false\" level=\"1\" textAlignment=\"left\" textColor=\"default\">Workspace Northstar</heading></blockcontainer><blockcontainer id=\"brief-subtitle\"><paragraph backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\"><textcolor stringValue=\"gray\">Product Launch Brief · Working draft</textcolor></paragraph></blockcontainer><blockcontainer id=\"brief-summary-title\"><heading backgroundColor=\"default\" isToggleable=\"false\" level=\"2\" textAlignment=\"left\" textColor=\"default\">Executive summary</heading></blockcontainer><blockcontainer id=\"brief-summary\"><paragraph backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\">Workspace Northstar introduces a faster, more focused way for teams to turn early ideas into coordinated work. The launch will prioritize a clear value story, a dependable first-run experience, and structured feedback from early customers.</paragraph></blockcontainer><blockcontainer id=\"brief-objectives-title\"><heading backgroundColor=\"default\" isToggleable=\"false\" level=\"2\" textAlignment=\"left\" textColor=\"default\">Objectives</heading></blockcontainer><blockcontainer id=\"brief-objective-1\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\">Communicate the product value in one clear, consistent story.</numberedlistitem></blockcontainer><blockcontainer id=\"brief-objective-2\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\">Give early users a smooth path from discovery to first success.</numberedlistitem></blockcontainer><blockcontainer id=\"brief-objective-3\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\">Capture actionable feedback during the first two weeks after launch.</numberedlistitem></blockcontainer><blockcontainer id=\"brief-audience-title\"><heading backg