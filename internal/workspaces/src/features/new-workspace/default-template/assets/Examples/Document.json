g backgroundColor=\"default\" isToggleable=\"false\" level=\"2\" textAlignment=\"left\" textColor=\"default\">Timeline</heading></blockcontainer><blockcontainer id=\"brief-timeline-table\"><table textColor=\"default\"><tablerow><tablecell backgroundColor=\"gray\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph><bold>Phase</bold></tableparagraph></tablecell><tablecell backgroundColor=\"gray\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph><bold>Timing</bold></tableparagraph></tablecell><tablecell backgroundColor=\"gray\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph><bold>Outcome</bold></tableparagraph></tablecell></tablerow><tablerow><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Plan</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Week 1</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Goals, audience, and positioning approved</tableparagraph></tablecell></tablerow><tablerow><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Prepare</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Weeks 2–3</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Launch assets complete and release validated</tableparagraph></tablecell></tablerow><tablerow><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Launch and learn</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Week 4</tableparagraph></tablecell><tablecell backgroundColor=\"default\" colspan=\"1\" rowspan=\"1\" textAlignment=\"left\" textColor=\"default\"><tableparagraph>Release shipped and feedback reviewed</tableparagraph></tablecell></tablerow></table></blockcontainer><blockcontainer id=\"brief-metrics-title\"><heading backgroundColor=\"default\" isToggleable=\"false\" level=\"2\" textAlignment=\"left\" textColor=\"default\">Success metrics</heading></blockcontainer><blockcontainer id=\"brief-metric-1\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\"><bold>Activation:</bold> 30% of new users complete the core workflow in their first session.</numberedlistitem></blockcontainer><blockcontainer id=\"brief-metric-2\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\"><bold>Adoption:</bold> 500 qualified teams create an organization in the first month.</numberedlistitem></blockcontainer><blockcontainer id=\"brief-metric-3\"><numberedlistitem backgroundColor=\"default\" textAlignment=\"left\" textColor=\"default\"><bold>Quality:</bold> Fewer than 2% of launch sessions encounter a blocking issue.</numberedlistitem></blockcontainer></blockgroup>"
