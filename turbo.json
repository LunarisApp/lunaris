{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "//#check": {
      "cache": true
    },
    "//#check:fix": {
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "coverage/**"
      ]
    },
    "@lunarisapp/ui#test": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    }
  },
  "globalEnv": [
    "LUNARIS_EDITION"
  ],
  "globalDependencies": [
    "tooling/editions/**",
    "tooling/licenses/**",
    "LICENSE",
    "ee/LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ]
}
