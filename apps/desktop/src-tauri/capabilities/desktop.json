{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Minimal permissions for the bundled Lunaris desktop shell",
  "windows": ["main", "panel-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "deep-link:default",
    "powersync:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://lunaris.app" },
        { "url": "https://*.lunaris.app" },
        { "url": "https://*" }
      ]
    }
  ]
}
