{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "LUNARIS_EDITION=enterprise bun run build --filter=api",
    "watchPatterns": [
      "/apps/api/**",
      "/bun.lock",
      "/bunfig.toml",
      "/internal/**",
      "/ee/**",
      "/package.json",
      "/packages/**",
      "/extensions/**",
      "/turbo.json",
      "/tooling/**"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "preDeployCommand": "bun run --filter=api db:migrate",
    "startCommand": "NODE_ENV=production bun /app/apps/api/dist/src/main.js",
    "sleepApplication": false,
    "ipv6EgressEnabled": false,
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 300,
    "overlapSeconds": 30,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
