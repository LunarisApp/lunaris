{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bunx turbo run build --filter=landing",
    "watchPatterns": [
      "/bun.lock",
      "/bunfig.toml",
      "/apps/landing/**",
      "/package.json",
      "/turbo.json"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "startCommand": "NODE_ENV=production bun run --filter=landing start",
    "sleepApplication": false,
    "ipv6EgressEnabled": false,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "overlapSeconds": 30,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
