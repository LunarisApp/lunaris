# Dev server
# Vite defaults to 5173. Set PORT to override. If the chosen port is busy,
# Vite walks to the next free one. Backend trusts http://localhost:* in
# non-production, so any port works without backend CORS changes.
# PORT=5173

# Backend
VITE_REGION_DIRECTORY_JSON=[{"id":"local","label":"Local","apiUrl":"http://localhost:3000","status":"active","default":true}]

# Analytics
VITE_POSTHOG_API_HOST=https://q.lunaris.app
VITE_POSTHOG_UI_HOST=https://us.i.posthog.com
VITE_POSTHOG_KEY=

# Cookie consent
VITE_PROBO_COOKIE_BANNER_ID=
VITE_PROBO_COOKIE_BANNER_BASE_URL=

# Error Tracking
VITE_SENTRY_DSN=
