# E2E CI overrides — merged into apps/api/.env by the e2e workflow.
# Flip EMAIL_VERIFICATION_DISABLED so Better Auth actually sends verification
# emails. RESEND_API_KEY is left empty, which writes an isolated E2E auth line
# (see internal/auth/src/server.ts) where Cypress scrapes the URL.
EMAIL_VERIFICATION_DISABLED=false
RESEND_API_KEY=
POLAR_DISABLED=true
# evlog writes pretty ANSI by default when NODE_ENV is not production.
# E2E_JSON_LOGS=true forces stringified JSON output so the cypress task
# can parse backend.log (see apps/api/src/instrument.ts).
E2E_JSON_LOGS=true
# Expose one-time auth links only in the isolated E2E backend log. Normal
# application and compliance logs remain redacted.
E2E_AUTH_EMAIL_LOGS=true
