{
  "name": "desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "bun run check:mcp-manifest && tsc -b && vite build && bun run assert:native-powersync",
    "build:dependencies": "turbo run build --filter=desktop^...",
    "check:mcp-manifest": "bun run --cwd ../../internal/agent-contracts check:mcp",
    "assert:native-powersync": "bun scripts/assert-native-powersync-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p agent-work/tsconfig.json --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:agent": "bun scripts/build-agent.ts",
    "build:notices": "bun ../../tooling/licenses/desktop.ts"
  },
  "dependencies": {
    "@powersync/common": "2.0.0",
    "@powersync/tauri-plugin": "0.0.6",
    "@repo/agent-contracts": "workspace:*",
    "@repo/app-shell": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/features": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "evlog": "^2.34.0",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@sinclair/typebox": "^0.34.41",
    "@repo/ee-composition": "workspace:*",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tauri-apps/plugin-process": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.11"
  }
}
